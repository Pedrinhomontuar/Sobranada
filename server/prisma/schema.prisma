// Diz como o Prisma gera o código que a gente usa no servidor
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Diz que o banco é PostgreSQL (o endereço vem do prisma.config.ts)
datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String     @id @default(uuid())
  nome      String
  email     String     @unique
  senhaHash String
  criadoEm  DateTime   @default(now())
  alimentos Alimento[]
}

model Alimento {
  id         String   @id @default(uuid())
  nome       String
  quantidade Float
  unidade    String
  validade   String
  criadoEm   DateTime @default(now())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}